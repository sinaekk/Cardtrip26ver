  m_Script: {fileID: 11500000, guid: 43d8c9ac4a13e074bbda48cda2074b64, type: 3}
  m_Name: QuizData_Default
  m_EditorClassIdentifier:
  Questions:
  - "\uC9C0\uAE08 \uC5EC\uD589 \uAC04\uB2E4\uBA74, \uC5B4\uB5A4 \uBD84\uC704\uAE30\uAC00\
    \ \uC880\uC544?"
  - "\uCE5C\uAD6C\uC640 \uD568\uAED8 \uAC04\uB2E4\uBA74 \uC5B4\uB5A4 \uACF3\uC774\
    \ \uB04C\uB824?"
  - "\uAC00\uC7A5 \uAE30\uB300\uB418\uB294 \uC5EC\uD589 \uC21C\uAC04\uC740 \uC5B8\
    \uC81C\uC57C?"
  - "\uC774 \uC911 \uD558\uB098\uB97C \uACE0\uB978\uB2E4\uBA74?"
  AnswerGroups:
  - Answers:
    - "\uC790\uC5F0\uC744 \uB290\uB084 \uC218 \uC788\uB294 \uC870\uC6A9\uD55C \uACF3"
    - "\uB180\uAC70\uB9AC, \uCCB4\uD5D8\uAC70\uB9AC\uAC00 \uB9CE\uC740 \uACF3"
    - "\uACE0\uC988\uB141\uD558\uACE0 \uC606 \uAC10\uC131\uC774 \uB290\uADA4\uC9C0\
      \uB294 \uACF3"
  - Answers:
    - "\uD638\uC218\uB098 \uC232\uC774 \uC788\uB294 \uC0B0\uCC45 \uCF54\uC2A4"
    - "\uB180\uC774\uAE30\uAD6C\uB098 \uCCB4\uD5D8\uC874"
    - "\uBBFC\uC18D\uCD5C\uC774\uB098 \uD14C\uB9C8\uD30C\uD06C"
  - Answers:
    - "\uD48D\uACBD \uC0AC\uC9C4 \uCC0D\uAE30"
    - "\uCCB4\uD5D8 \uD65C\uB3D9"
    - "\uC870\uC6A9\uD788 \uB458\uB7EC\uBCF4\uBA70 \uC0AC\uC0C9\uD558\uAE30"
  - Answers:
    - "\uD790\uB9C1 \uC0B0\uCC45\uC874"
    - "\uB180\uC774\uAE30\uAD6C\uB098 \uCCB4\uD5D8\uC874"
    - "\uC720\uC11C \uAE4A\uC740 \uAC74\uBB3C\uACFC \uB9C8\uC744"
  Recommendations:
  - "\uD658\uACBD(\uD790\uB9C1/\uC790\uC5F0): \uC6A9\uB2F4\uD638\uC218, \uACBD\uC548\
    \uCC9C, \uAE30\uD765\uD638\uC218\uACF5\uC6D0, \uBC31\uC554\uC0B0, \uC11D\uC131\
    \uC0B0, \uCCAD\uB144\uAE40\uB300\uAC74\uAE38, \uAD11\uAD50\uC0B0, \uACE0\uAE30\
    \uB9AC \uACC4\uACE1, \uC0AC\uACC4\uC808\uC0B0\uCC45\uB85C(\uCC98\uC778\uAD6C)"
  - "\uBB38\uD654(\uCCB4\uD5D8/\uB180\uC774/\uC990\uAE40): \uD55C\uAD6D\uBBFC\uC18D\
    \uCD5C, \uC5D0\uBC84\uB79C\uB4DC, \uC640\uC6B0\uC815\uC0AC, \uB18D\uCD5C\uD14C\
    \uB9C8\uD30C\uD06C, \uACE4\uCDA9\uD14C\uB9C8\uD30C\uD06C, \uBCF4\uC815\uB3D9\
    \ \uCE74\uD398\uAC70\uB9AC"
  - "\uC5ED\uC0AC(\uC720\uC0B0/\uC778\uBB38/\uAC10\uC131): \uCC98\uC778\uC131, \uBC31\
    \uC554\uACE0\uD0DD, \uB0A8\uC0AC\uC5D0\uB2F4\uCD5C, \uC6A9\uC778\uC911\uC559\
    \uC2DC\uC7A5, \uC2EC\uACF5\uC11C\uC6D0, \uC870\uC120\uBC31\uC790\uBC15\uBB3C\
    \uAD00, \uAE40\uB300\uAC74\uAE30\uB150\uAD00, \uC2EC\uACF5 \uC11C\uC6D0 \uACE0\
    \uD0DD\uAD70"
